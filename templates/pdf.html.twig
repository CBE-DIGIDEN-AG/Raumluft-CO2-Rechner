<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Kohlendioxid-Berechnungs- und Bewertungstool (BNB){% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}

        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        <meta name="description" content="Co2 Tool">
        <meta name="keywords" content="Co2 Tool">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="author" content="CBE">

        <style>
            @page { margin: 100px 25px; }
            header { position: fixed; top: -60px; left: 0; right: 0; height: 60px;border-bottom: 2px solid #5a5a5a; }
            footer { position: fixed; bottom: -60px; left: 0; right: 0; height: 50px; border-top: 2px solid #5a5a5a;padding-top: 10px;display: flex; justify-content: space-between; }

            header strong { font-family: 'OpenSans', sans-serif; font-size: 22px; }

            footer .pagetotal {
                counter-reset: pageTotal;
            }
            footer .pagetotal {
                counter-increment: pageTotal;
            }

            footer .pagenum:before { content: counter(page); }
            footer {

            }

            footer .pagetotal:before { content: counter(pageTotal); }

            main > div { page-break-after: always; }
            main > div:last-child { page-break-after: avoid; }
            body { font-family: 'OpenSans', sans-serif; font-size: 12px; }

            h1 {font-size: 30px;line-height: 1.3;margin-bottom: 30px}
            h2 {font-size: 26px;line-height: 1.3;margin-bottom: 20px}
            h3 {font-size: 22px;line-height: 1.3;margin-bottom: 18px}

            table { border: 1px solid #aebac6; }
            table { width: 100% !important; border-spacing: 0;}
            table thead tr th {font-size: 11px; background-color: #e5ebf0; padding: 6px 10px;text-align: center; border-right: 1px solid #aebac6;}
            table tbody tr td { font-size: 12px; padding: 6px 10px; background-color: #f2f5f7; border-top: 1px solid #aebac6; border-right: 1px solid #aebac6; text-align: center; vertical-align: top; }
            table tbody tr td[colspan] { background-color: white; }
            table thead tr th:last-child { border-right: none;}
            table tbody tr td:last-child { border-right: none; }
            table .text-align-left { text-align: left; }
            table .text-align-right { text-align: right; }
            table tbody tr td strong {font-weight: bold}

            table table { border:0; }
            table table tr th { background-color: #ffffff; border:0; font-size: 10px; padding: 3px 5px; }
            table table tr td { background-color: #ffffff; border:0; font-size: 10px; padding: 3px 5px; border-top: 1px solid #eeeeee; }

            .c50 { width: 48%; display: inline-block; }
            .right { text-align: right; }
        </style>
    </head>
    <body>
        {% block body %}
            <header>
                <div class="c50">
                    <strong>Berechnung mit freien Randbedingungen</strong>
                </div>
                <div class="c50 right">
                    <img src="{{ logo }}"  alt="Logo Bundesinstitut für Bau- Stadt- und Raumforschung" width="295" height="50" />
                </div>
            </header>
            <footer>
                <div class="c50">
                    <strong>{{ projectdata.project.projektname }}</strong>
                    - {{ projectdata.project.date }}
                </div>
                <div class="c50 right">
                    Seite <span class="pagenum"> von </span><span class="pagetotal"></span>
                </div>
            </footer>
            <main>
                <div>
                    <h1>Projektangaben</h1>
                    <strong>Projektbezeichnung:</strong> {{ projectdata.project.projektname }}<br>
                    <strong>Gebäudebezeichnung:</strong> {{ projectdata.project.building }}<br>
                    <strong>Beschreibung:</strong> {{ projectdata.project.projectdescroption }}<br>
                    <strong>Datum:</strong> {{ projectdata.project.date }}<br>
                    <strong>Postleitzahl:</strong> {{ projectdata.project.zipcode }}<br>
                    <strong>Ort:</strong> {{ projectdata.project.city }}<br>
                    <strong>Berechnungsmethode:</strong> {{ selectvalues(formdata.project.method, projectdata.project.method) }}<br>

                    <br>
                    <h2>Klimarandbedingungen</h2>
                    <strong>Außentemperatur in °C:</strong> {{ projectdata.dayprofile.t_e }}<br>
                    <strong> Kohlendioxidkonzentration der Außenluft (in ppm):</strong> {{ projectdata.dayprofile.cAUL }}<br>
                    <strong>Meteorologische Windgeschwindigkeit (in m/s):</strong> {{ projectdata.dayprofile.v_meteo }}<br>

                    <br>
                    <h2>Gebäudeangaben</h2>
                    <strong>Nettovolumen des Gebäudes (in m³):</strong> {{ selectvalues(formdata.buildingdetails.VB, projectdata.buildingdetails.VB) }}<br>


                    {% if projectdata.buildingdetails.VB < 1500 %}
                        {% if projectdata.buildingdetails.LDH.base == 'messasure' %}
                            <strong>Luftwechsel bei 50 Pa Druckdifferenz - n50 (in 1/h):</strong> {{ projectdata.buildingdetails.n50 }}<br>
                        {% endif %}
                        {% if projectdata.buildingdetails.LDH.base == 'defaultvalue' %}
                            <strong>Luftwechsel bei 50 Pa Druckdifferenz - n50 (in 1/h):</strong> {{ selectvalues(formdata.buildingdetails.luftdichtheit, projectdata.buildingdetails.n50) }}<br>
                        {% endif %}
                    {% endif %}

                    {% if projectdata.buildingdetails.VB >= 1500 %}
                        {% if projectdata.buildingdetails.LDH.base == 'messasure' %}
                            <strong>hüllflächenbezogene Luftdurchlässigkeit bei 50 Pa Druckdifferenz - q50 (in m³/(m²h)):</strong> {{ projectdata.buildingdetails.n50 }}<br>
                        {% endif %}
                        {% if projectdata.buildingdetails.LDH.base == 'defaultvalue' %}
                            <strong>hüllflächenbezogene Luftdurchlässigkeit bei 50 Pa Druckdifferenz - q50 (in m³/(m²h)):</strong> {{ selectvalues(formdata.buildingdetails.luftdichtheit, projectdata.buildingdetails.q50) }}<br>
                        {% endif %}
                    {% endif %}

                    <strong>Sind Außenluftdurchlässe vorhanden?:</strong> {{ projectdata.buildingdetails.fATD }}<br>
                    <strong>Abschirmung:</strong> {{ selectvalues(formdata.buildingdetails.abschirmung, projectdata.buildingdetails.abschirmung) }}
                    <br>

                    <br>
                    <h2>Räume</h2>
                    <table>
                        <thead>
                            <tr>
                                <th class="text-align-left">Name</th>
                                <th>Raumnutzungstyp</th>
                                <th>Innentemperatur (in °C)</th>
                                <th>Nutzfläche des Raumtyps (in m²)</th>
                                <th>Lichte Raumhöhe (in m)</th>
                                {% if projectdata.buildingdetails.VB >= 1500 %}
                                    <th>Wärmeübertragende Umfassungsfläche des Raums in m²</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for room in projectdata.dayprofile.rooms %}
                                <tr>
                                    <td class="text-align-left">{{ room.name }}</td>
                                    <td>{{ room.usetype }}</td>
                                    <td>{{ room.t_in }}</td>
                                    <td>{{ room.A }}</td>
                                    <td>{{ room.H }}</td>
                                    {% if projectdata.buildingdetails.VB >= 1500 %}
                                        <td>{{ room.Ae }}</td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>

                    <br>
                    <h2>Fenstertypen</h2>
                    <table>
                        <thead>
                        <tr>
                            <th class="text-align-left">Name</th>
                            <th>Fensterart</th>
                            {% if  projectdata.project.method == '4108' %}
                                <th>Lichte Öffnungsbreite des Fensters (in m)</th>
                                <th>Lichte Öffnungshöhe des Fensters (in m)</th>
                                <th>Detaildaten des Fenstertypen</th>
                                {% endif %}
                            {% if  projectdata.project.method == '16798' %}
                                <th>Maximale Öffnungsfläche des Fensters (in m²)</th>
                                <th>Höhe der freien Fläche des Fensters (in m)</th>
                            {% endif %}
                        </tr>
                        </thead>
                        <tbody>
                        {% for window in projectdata.dayprofile.windowtypes %}
                            <tr>
                                <td class="text-align-left">{{ window.name }}</td>
                                <td>{% if  projectdata.project.method == '4108' %}
                                        {{ selectvalues(formdata.windowtypes.type4108, window.win_Typ) }}
                                    {% endif %}
                                    {% if  projectdata.project.method == '16798' %}
                                        {{ selectvalues(formdata.windowtypes.type16798, window.win_Typ) }}
                                    {% endif %}
                                </td>
                                {% if  projectdata.project.method == '4108' %}
                                    <td>{{ window.b_k }}</td>
                                {% endif %}
                                {% if  projectdata.project.method == '16798' %}
                                    <td>{{ window.AW_max_k }}</td>
                                {% endif %}
                                <td>{{ window.h_k }}</td>
                                {% if  projectdata.project.method == '4108' %}
                                    <td>
                                        {% if  window.win_Typ == 'Parallelabstellfenster' %}
                                            Fugenlänge des Fensters in Parallelabstellung: {{ window.l_Fuge_k }}
                                        {% endif %}
                                        {% if  window.win_Typ == 'Schwingfenster' %}
                                            Rahmendicke des Schwingfensters (in m): {{ window.d_k }}
                                        {% endif %}
                                        {% if  window.win_Typ == 'Lamellenfenster' %}
                                            Lamellenanzahl: {{ window.n_k }}
                                        {% endif %}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>


                    <h2>Varianten</h2>
                    <table>
                        <thead>
                        <tr>
                            <th class="text-align-left">Name</th>
                            <th>Raum</th>
                            <th>Wie wird der Raum belüftet?</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for roomtype in projectarraydata.dayprofile.roomtypes %}
                            <tr>
                                <td class="text-align-left">{{ roomtype.name }}</td>
                                <td>{{ projectdata.dayprofile.rooms[roomtype.room].name }}</td>
                                <td>{{ selectvalues(formdata.roomtypes.ventilation, roomtype.Anl) }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>

                    <h2>Fensterangaben im Raum</h2>

                    {% for roomtype in projectarraydata.dayprofile.roomtypes %}
                        {% if roomtype.Anl != 'mechanical' %}
                            <h3>{{ roomtype.name }}</h3>

                            {% if  projectdata.project.method == '4108' %}
                                <strong>mittlere Höhe der Lüftungszone über Erdreichniveau:</strong> {{ projectarraydata.dayprofile.relwindowroomtypes[roomtype.key].H_Grund_Zone }}<br>
                            {% endif %}
                            <strong>Tritt einseitige Lüftung auf?</strong> {{ projectarraydata.dayprofile.relwindowroomtypes[roomtype.key].einseitig }}<br>
                            <br>
                            <table>
                                <thead>
                                <tr>
                                    <th class="text-align-left">Fenstergruppe</th>
                                    <th>Fenster</th>
                                    {% if projectarraydata.dayprofile.relwindowroomtypes[roomtype.key].einseitig == 'nein' %}
                                        <th>Himmelsrichtung der Fenster</th>
                                    {% endif %}

                                    {% if  projectdata.project.method == '4108' %}
                                        <th>Brüstungshöhe (in m)</th>
                                    {% endif %}

                                    {% if  projectdata.project.method == '16798' %}
                                        <th>Mittlere Höhe des Fensters in Bezug auf die Bodenhöhe der Lüftungszone in m</th>
                                    {% endif %}

                                    {% if  projectdata.project.method == '16798' and projectarraydata.dayprofile.relwindowroomtypes[roomtype.key].einseitig == 'nein' %}
                                        <th>Winkel des Fensters</th>
                                    {% endif %}

                                    <th>Anzahl der Fenster</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for windowgroup in roomtype.windowgroups %}
                                    <tr>
                                        <td class="text-align-left">{{ windowgroup.name }}</td>
                                        <td>
                                            {% for window in projectdata.dayprofile.windowtypes %}
                                                {% if window.key == windowgroup.windowtypes %}
                                                    {{ window.name }}
                                                {% endif %}
                                            {% endfor %}
                                        </td>
                                        {% if projectarraydata.dayprofile.relwindowroomtypes[roomtype.key].einseitig == 'nein' %}
                                            <td>{{ selectvalues(formdata.relwindowroomtypes.aw_k,windowgroup.aw_k) }}</td>
                                        {% endif %}

                                        {% if  projectdata.project.method == '4108' %}
                                            <td>{{ windowgroup.windowdata[0].h_Bruest_k }}</td>
                                        {% endif %}

                                        {% if  projectdata.project.method == '16798'  %}
                                            <td>{{ windowgroup.windowdata[0].hw_path_k }}</td>
                                        {% endif %}

                                        {% if  projectdata.project.method == '16798' and projectarraydata.dayprofile.relwindowroomtypes[roomtype.key].einseitig == 'nein' %}
                                            <td>{{ windowgroup.windowdata[0].Bw_k }}</td>
                                        {% endif %}

                                        <td>{{ windowgroup.windowdata[0].windowcount }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                            <br>
                        {% endif %}
                    {% endfor %}

                    <h2>Lüftungskonzepte</h2>

                    {% for roomtype in projectarraydata.dayprofile.roomtypes %}
                        {% if roomtype and projectarraydata.dayprofile.usageprofiles[roomtype.key].intervals|length > 0 %}
                            <h3>Lüftungskonzept für {{ roomtype.name }}</h3>
                            <strong>Startzeit: </strong><span>{{ projectarraydata.dayprofile.usageprofiles[roomtype.key].start }}</span>
                            <br><br>
                            <table>
                                <thead>
                                <tr>
                                    <th class="text-align-left">Name</th>
                                    <th>Daten</th>
                                </tr>
                                </thead>
                                <tbody>

                                {% for interval in projectarraydata.dayprofile.usageprofiles[roomtype.key].intervals %}
                                    <tr>
                                        <td class="text-align-left">{{ interval.name }}</td>
                                        <td>
                                            Dauer: {{ interval.duration }}min<br><br>
                                            Anzahl der Personen (Erwachsene):
                                                {{ interval.count_teacher }}
                                                {% if interval.count_teacher > 0 %}
                                                    -  {{ selectvalues(formdata.interval.type, interval.type_teacher) }} - {{ interval.emissionrate_teacher }} l/h
                                                {% endif %}
                                                <br>
                                            Anzahl der Personen der Jahrgangsstufe 5-13:
                                                {{ interval.count_students }}
                                                {% if interval.count_students > 0 %}
                                                    -  {{ selectvalues(formdata.interval.type, interval.type_students) }} - {{ interval.emissionrate_students }} l/h
                                                {% endif %}
                                                <br>
                                            Anzahl der Personen der Jahrgangsstufe 1-4:
                                                {{ interval.count_prestudents }}
                                                {% if interval.count_prestudents > 0 %}
                                                    -  {{ selectvalues(formdata.interval.type, interval.type_prestudents) }} - {{ interval.emissionrate_prestudents }} l/h
                                                {% endif %}
                                                <br><br>

                                            {% if roomtype.Anl == 'mechanical' or roomtype.Anl == 'hybrid' %}
                                                {% if interval.q_v_mech %}
                                                    <span>Luftvolumenstrom der Lüftungsanlage (in m³/h): {{ interval.q_v_mech}} </span>
                                                    <br>
                                                    <br>
                                                {% endif %}
                                            {% endif %}

                                            {% for groupkey, windowgroup in projectarraydata.dayprofile.roomtypes[roomtype.key].windowgroups %}
                                                <strong>{{ windowgroup.name }}</strong><br>

                                                {% set window = projectarraydata.dayprofile.windowtypes[windowgroup.windowtypes] %}

                                                {% if  projectdata.project.method == '4108' %}
                                                    {% set open = 0 %}
                                                    {% set varname_no = 'no_Fe' %}

                                                    {% if windowgroup.aw_k == '0' %}
                                                            {% set varname_no = varname_no ~ '_S' %}
                                                    {% endif %}

                                                    {% if windowgroup.aw_k == '90' %}
                                                        {% set varname_no = varname_no ~ '_W' %}
                                                    {% endif %}

                                                    {% if windowgroup.aw_k == '180' %}
                                                        {% set varname_no = varname_no ~ '_N' %}
                                                    {% endif %}

                                                    {% if windowgroup.aw_k == '270' %}
                                                        {% set varname_no = varname_no ~ '_O' %}
                                                    {% endif %}

                                                    {% set varname_no = varname_no ~'_k' %}

                                                    {% if  interval.windows.0.group[groupkey][varname_no] %}
                                                        {% set open = interval.windows.0.group[groupkey][varname_no] %}
                                                    {% endif %}

                                                    <strong>Fenster: </strong>{{ window.name }} ({{ window.win_Typ }})  - {{ open }} von {{ windowgroup.windowdata[0].windowcount }} geöffnet<br>
                                                {% endif %}
                                                {% if  projectdata.project.method == '16798' %}
                                                    <strong>Fenster: </strong>{{ window.name }} ({{ window.win_Typ }})  - {{ interval.windows.0.group[groupkey].Nw}} von {{ windowgroup.windowdata[0].windowcount }} geöffnet<br>
                                                {% endif %}

                                                {% if  projectdata.project.method == '4108' %}
                                                    {% if interval.windows.0.group[groupkey].alpha_k %}
                                                        Öffnungswinkel des Fensters: {{ interval.windows.0.group[groupkey].alpha_k }}°
                                                        <br>
                                                    {% endif %}
                                                    {% if interval.windows.0.group[groupkey].x_k %}
                                                        Öffnungsweite: {{ interval.windows.0.group[groupkey].x_k }}m
                                                        <br>
                                                    {% endif %}
                                                {% endif %}

                                                {% if  projectdata.project.method == '16798' %}
                                                    {% if interval.windows.0.group[groupkey].Nw > 0 %}
                                                        {% if interval.windows.0.group[groupkey].alpha_k %}
                                                            Öffnungswinkel des Fensters: {{ interval.windows.0.group[groupkey].alpha_k }}°
                                                        {% endif %}
                                                        {% if interval.windows.0.group[groupkey].x_k %}
                                                            Öffnungsweite: {{ interval.windows.0.group[groupkey].x_k }}m
                                                        {% endif %}
                                                    {% endif %}
                                                {% endif %}

                                                <br>
                                            {% endfor %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        {% endif %}
                    {% endfor %}

                    <h2>Mittelwerte für den gesamten Betrachtungszeitraum für komplett geöffnete Fenster</h2>
                    <table>
                        <thead>
                        <tr>
                            <th class="text-align-left">Lüftungsvariante</th>
                            <th>CO2-Konzentration Mittelwert</th>
                            <th>Kumulierte Grenzwertüberschreitung der CO2-Konzentration</th>
                        </tr>
                        </thead>
                        <tbody>
                            {% for item in cumulated %}
                                <tr>
                                    <td class="text-align-left">{{ item.name }}</td>
                                    <td class="text-align-left">{{ item.avarage }}</td>
                                    <td class="text-align-left">{{ item.cumulative_exceeded|number_format(2, ',', '.') }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div>
                    <img src="{{ linechart }}" width="750"/>
                    <img src="{{ mittelwertchart }}" width="550"/>

                </div>
            </main>
        {% endblock %}
    </body>
</html>